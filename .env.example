# Database
DATABASE_URL="postgresql://wolog:wolog@localhost:5432/wolog?schema=public"

# JWT
JWT_SECRET="change-me-to-a-random-secret"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY_DAYS=30

# Apple Sign In
APPLE_CLIENT_ID="com.your.app.bundle.id"

# Google Sign In
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Server
PORT=3000
NODE_ENV=development

# Shares
SHARE_DEFAULT_TTL_DAYS=90
SHARE_BASE_URL="https://wolog.app/s/"

# AI Connector (OAuth provider for Claude MCP / ChatGPT Action)
# Public URL of this API — used in OAuth discovery metadata and the OpenAPI spec
PUBLIC_BASE_URL="https://wolog-api-local.up.railway.app"
# Apple Services ID for Sign in with Apple JS on the web consent screen
# (separate from APPLE_CLIENT_ID, which is the iOS bundle id)
APPLE_WEB_CLIENT_ID=""
# Contents of the domain-association file Apple generates for the Services ID;
# served at /.well-known/apple-developer-domain-association.txt for verification
APPLE_DOMAIN_ASSOCIATION=""
# Google Web-application OAuth client id for GSI on the web consent screen
# (separate from GOOGLE_CLIENT_ID, which is the iOS client). The backend
# verifies app + web Google tokens against both.
GOOGLE_WEB_CLIENT_ID=""
# Pre-registered OAuth clients as a JSON array (e.g. the ChatGPT Action).
# Claude's MCP connector can instead self-register via POST /oauth/register.
# OAUTH_STATIC_CLIENTS='[{"id":"chatgpt-action","name":"ChatGPT","secret":"<random>","redirectUris":["https://chat.openai.com/aip/<gpt-id>/oauth/callback"]}]'
OAUTH_STATIC_CLIENTS=""
# Connector token lifetimes
CONNECTOR_ACCESS_TTL_MINUTES=60
CONNECTOR_REFRESH_TTL_DAYS=30
# Email-based sign-in on the consent screen for local testing.
# Ignored when NODE_ENV=production. NEVER enable in production.
OAUTH_DEV_LOGIN=false
